<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PERMISSIONS ARE DELIBERATELY MINIMAL. Every one below is justified; anything not listed
         was removed on purpose. Adding one back is a Play review question and a user-trust cost,
         so justify it here rather than pasting it from a plugin's README.

         NO INTERNET. This app makes zero network calls – no analytics, no crash reporting, no
         accounts, no cloud. Everything happens over BLE to hardware in the user's hand. That is
         what makes the Play Data Safety declaration "collects no data, shares no data", and
         declaring network access we never use would undermine it for nothing. Debug and profile
         builds still get INTERNET from their own manifests (src/debug, src/profile) because the
         Flutter tool needs it for hot reload – release builds do not. -->

    <!-- Legacy Bluetooth, Android 11 (API 30) and below only. Superseded by the _SCAN/_CONNECT
         split on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Scanning, to find a Draupnir. neverForLocation is an assertion we mean: scan results are
         used to match a device name and connect, never to derive position. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <!-- Talking to the board once connected. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location, ONLY on Android 11 and below, where the platform required it for BLE scanning
         and offered no way to opt out. On API 31+ the neverForLocation flag above replaces it, so
         the ceiling keeps a modern device from ever being asked for location by this app. Without
         the ceiling this reads as an unexplained location grab – a Play review question and a
         reasonable thing for a user to distrust. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- BLUETOOTH_ADVERTISE is NOT declared. This app is a BLE central: it scans and connects.
         It never advertises. The permission came from plugin boilerplate. -->

    <application
        android:label="Draupnir Forge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
