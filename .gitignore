# Build artifacts
/build/
*.hex
*.bin
*.elf
*.map
# PlatformIO
.pio/
# IDE
.vscode/
.idea/
# OS junk
.DS_Store
Thumbs.db
# Secrets / local config (never commit Wi-Fi creds etc.)
secrets.h
wifi_creds.h
*.local

# Build logs
build_fw.log
*.log

# Vendored toolchain. arduino-cli is a freely downloadable tool and does not belong in the repo
# (it was ~54 MB of the clone). Install it per docs/Toolchain_arduino-cli.md and keep it here, or
# anywhere on PATH.
arduino-cli.exe
arduino-cli.zip

# Photos and device screenshots. Useful locally, but ~9 MB of binaries that bloat a public clone
# and cannot be diffed or reviewed. Attach them to issues/PRs instead.
companion_app/Screenshots/

# Local-environment agent config. CLAUDE.md and AGENTS.md ARE tracked deliberately — they are the
# shared project context and must be edited together (see CLAUDE.md). GEMINI.md is local-only.
GEMINI.md

# Flutter/Dart
companion_app/.dart_tool/
companion_app/build/
companion_app/android/local.properties
companion_app/android/.gradle/

# Font build inputs (TTF sources for lv_font_conv). The generated LVGL .c font tables are what
# get committed; the source TTF is a build input, not source.
tools/fonts/

# OTA signing keys. The PRIVATE key must never be committed -- this repo is public, and anyone
# holding it can push firmware to every shipped unit. The PUBLIC key is generated into
# firmware/Waveshare_LVGL_Test/ota_pubkey.h and IS committed, which is the point.
tools/ota_keys/*.pem

# Bundled OTA firmware image. This is a build OUTPUT (of *.bin above) but it ships INSIDE the APK
# on purpose -- see FirmwareSource in companion_app/lib/services/firmware_source.dart -- so it IS
# committed, unlike every other *.bin in this repo.
!companion_app/assets/firmware/firmware.bin
